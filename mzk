#!/usr/bin/env node
// MZK Composer — linha de comando (Linux).
// Uso: ./mzk build|render <MZK-0042 | arquivo.json>... [--all] [--dir D] [--out D] [--registrar] [--no-pdf]

import { existsSync, mkdirSync, mkdtempSync, readdirSync, rmSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { createServer } from 'node:http';
import { homedir, networkInterfaces, tmpdir } from 'node:os';
import { basename, dirname, extname, join, relative, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';
import { buildMidi } from './src/core/midi.js';
import { buildLilypond } from './src/core/lilypond.js';
import { copyrightLine, fileBaseName, validateProject } from './src/core/project.js';
import { buildRenderScore } from './src/render/score.js';
import { buildNrt, loadSynthDefs } from './src/render/nrt.js';

const HELP = `MZK Composer

  ./mzk build MZK-0042             gera .mid, .ly e .pdf de um projeto
  ./mzk build caminho/projeto.json  idem, a partir de um arquivo
  ./mzk build --all                todos os projetos do diretório
  ./mzk render MZK-0042            gera o .mp3 (amostra para o Suno; precisa do SuperCollider)
  ./mzk render --all               idem, para todos os projetos
  ./mzk polir "Muzeka - Gênero - Título.mp3"...
                                   trata faixas do Suno (sibilância, agudo que piora com o tempo,
                                   volume, capa da Muzeka) e salva em ~/Muzeka/radio/<Gênero>/; o original fica
                                   em ~/Muzeka/originais-suno/. Níveis: --suave, --medio (padrão), --forte
  ./mzk serve [--port 8080]        abre o app no navegador (e no iPhone, na mesma rede Wi-Fi)

Opções:
  --dir <pasta>     onde ficam os .json (padrão: $MZK_DIR ou ~/Muzeka/composicoes/projects)
  --out <pasta>     onde gravar (padrão: pasta "exports" ao lado da pasta do projeto)
  --registrar       faz commit dos arquivos gerados e envia ao GitHub (prova datada)
  --no-pdf          não chama o LilyPond (gera só .mid e .ly)
  --wav             (render) guarda também o .wav sem compressão
  --no-pull         não busca as versões novas do GitHub antes de gerar
`;

function parseArgs(argv) {
  const opts = { targets: [], all: false, dir: null, out: null, registrar: false, pdf: true, pull: true };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--all') opts.all = true;
    else if (a === '--registrar') opts.registrar = true;
    else if (a === '--no-pdf') opts.pdf = false;
    else if (a === '--no-pull') opts.pull = false;
    else if (a === '--wav') opts.wav = true;
    else if (a === '--dir') opts.dir = argv[++i];
    else if (a === '--out') opts.out = argv[++i];
    else if (a.startsWith('--')) throw new Error(`Opção desconhecida: ${a}`);
    else opts.targets.push(a);
  }
  return opts;
}

function projectsDir(opts) {
  return resolve(opts.dir || process.env.MZK_DIR || join(homedir(), 'Muzeka', 'composicoes', 'projects'));
}

function resolveTarget(target, dir) {
  if (target.endsWith('.json') || existsSync(target)) {
    if (!existsSync(target)) throw new Error(`Arquivo não encontrado: ${target}`);
    return resolve(target);
  }
  if (!existsSync(dir)) throw new Error(`Diretório de projetos não existe: ${dir} (use --dir)`);
  const matches = readdirSync(dir).filter((f) => f.endsWith('.json') && (f === `${target}.json` || f.startsWith(`${target}_`)));
  if (!matches.length) throw new Error(`Projeto ${target} não encontrado em ${dir}`);
  if (matches.length > 1) throw new Error(`Mais de um arquivo para ${target}: ${matches.join(', ')}`);
  return join(dir, matches[0]);
}

function run(cmd, args, cwd) {
  return spawnSync(cmd, args, { cwd, encoding: 'utf8' });
}

function buildOne(jsonPath, opts) {
  const project = JSON.parse(readFileSync(jsonPath, 'utf8'));
  const errors = validateProject(project);
  if (errors.length) throw new Error(`${basename(jsonPath)} é inválido:\n  - ${errors.join('\n  - ')}`);

  const outDir = resolve(opts.out || join(dirname(dirname(jsonPath)), 'exports'));
  mkdirSync(outDir, { recursive: true });
  const base = fileBaseName(project);
  const files = [];

  const midPath = join(outDir, `${base}.mid`);
  writeFileSync(midPath, buildMidi(project));
  files.push(midPath);

  const lyPath = join(outDir, `${base}.ly`);
  writeFileSync(lyPath, buildLilypond(project));
  files.push(lyPath);

  if (opts.pdf) {
    const r = run('lilypond', ['-l', 'WARN', '-o', base, `${base}.ly`], outDir);
    if (r.error) console.warn('  ! LilyPond não encontrado — PDF não gerado (sudo apt install lilypond).');
    else if (r.status !== 0) throw new Error(`LilyPond falhou para ${base}.ly:\n${r.stderr}`);
    else files.push(join(outDir, `${base}.pdf`));
    if (r.stderr && r.status === 0) process.stderr.write(r.stderr);
  }

  console.log(`✓ ${project.meta.id} — ${project.meta.title}`);
  for (const f of files) console.log(`    ${relative(process.cwd(), f) || f}`);
  return { project, files, outDir };
}

const LOUDNESS = { I: -14, TP: -1, LRA: 11 }; // padrão de streaming

function scsynthCommand() {
  const bin = process.env.MZK_SCSYNTH || 'scsynth';
  const probe = spawnSync(bin, ['-v'], { encoding: 'utf8' });
  if (probe.error) {
    throw new Error('SuperCollider não encontrado. Instale uma vez com: ./scripts/instalar-som.sh');
  }
  const extra = process.env.MZK_SC_PLUGINS ? ['-U', process.env.MZK_SC_PLUGINS] : [];
  return { bin, extra };
}

/** .json → .mp3 (SuperCollider sem tempo real + ffmpeg com volume de streaming). */
function renderOne(jsonPath, opts, sc) {
  const project = JSON.parse(readFileSync(jsonPath, 'utf8'));
  const errors = validateProject(project);
  if (errors.length) throw new Error(`${basename(jsonPath)} é inválido:\n  - ${errors.join('\n  - ')}`);
  const outDir = resolve(opts.out || join(dirname(dirname(jsonPath)), 'exports'));
  mkdirSync(outDir, { recursive: true });
  const base = fileBaseName(project);
  const score = buildRenderScore(project);
  const tmp = mkdtempSync(join(tmpdir(), 'mzk-render-'));
  try {
    const oscPath = join(tmp, 'score.osc');
    const wavPath = join(tmp, 'mix.wav');
    writeFileSync(oscPath, buildNrt(score, loadSynthDefs(join(ROOT, 'sc', 'defs'))));
    const r = run(sc.bin, [...sc.extra, '-o', '2', '-N', oscPath, '_', wavPath, '48000', 'WAV', 'float']);
    if (r.status !== 0 || !existsSync(wavPath)) throw new Error(`SuperCollider falhou:\n${(r.stderr || r.stdout).slice(-800)}`);

    // Volume final: loudnorm em duas passadas (mede, depois aplica linear).
    const target = `I=${LOUDNESS.I}:TP=${LOUDNESS.TP}:LRA=${LOUDNESS.LRA}`;
    const m = run('ffmpeg', ['-hide_banner', '-nostats', '-i', wavPath, '-af', `loudnorm=${target}:print_format=json`, '-f', 'null', '-']);
    if (m.error) throw new Error('ffmpeg não encontrado (sudo apt install ffmpeg).');
    const json = (m.stderr.match(/\{[\s\S]*?\}/g) || []).pop();
    if (!json) throw new Error(`ffmpeg não mediu o volume:\n${m.stderr.slice(-500)}`);
    const mm = JSON.parse(json);
    const af = `loudnorm=${target}:linear=true:measured_I=${mm.input_i}:measured_TP=${mm.input_tp}`
      + `:measured_LRA=${mm.input_lra}:measured_thresh=${mm.input_thresh}:offset=${mm.target_offset},aresample=44100`;
    const meta = project.meta;
    const tags = {
      title: meta.title,
      artist: (meta.composers || []).join(', '),
      date: String(meta.year),
      copyright: copyrightLine(meta),
      comment: `${meta.id} · amostra MZK Composer (${score.pack.name}) · ${project.settings.bpm} bpm`,
    };
    const files = [];
    const mp3Path = join(outDir, `${base}.mp3`);
    const e = run('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-y', '-i', wavPath, '-af', af,
      ...Object.entries(tags).flatMap(([k, v]) => ['-metadata', `${k}=${v}`]),
      '-c:a', 'libmp3lame', '-b:a', '320k', '-id3v2_version', '3', mp3Path]);
    if (e.status !== 0) throw new Error(`ffmpeg falhou ao gerar o mp3:\n${e.stderr}`);
    files.push(mp3Path);
    if (opts.wav) {
      const wavOut = join(outDir, `${base}.wav`);
      const w = run('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-y', '-i', wavPath, '-af', af, '-c:a', 'pcm_s24le', wavOut]);
      if (w.status !== 0) throw new Error(`ffmpeg falhou ao gerar o wav:\n${w.stderr}`);
      files.push(wavOut);
    }
    const secs = Math.round(score.duration);
    console.log(`✓ ${meta.id} — ${meta.title}  (${score.pack.name}, ${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')})`);
    for (const f of files) console.log(`    ${relative(process.cwd(), f) || f}`);
  } finally {
    rmSync(tmp, { recursive: true, force: true });
  }
}

/** Repassa ao polidor em Python (numpy + ffmpeg). */
function polir(args) {
  const files = [];
  let nivel = 'medio';
  for (const a of args) {
    if (a === '--suave' || a === '--medio' || a === '--forte') nivel = a.slice(2);
    else if (a.startsWith('--')) throw new Error(`Opção desconhecida: ${a}`);
    else files.push(a);
  }
  if (!files.length) throw new Error('Informe o(s) arquivo(s) .mp3 do Suno ("Muzeka - Gênero - Título.mp3").');
  const r = spawnSync('python3', [join(ROOT, 'scripts', 'polir.py'), '--nivel', nivel, ...files], { stdio: 'inherit' });
  if (r.error) throw new Error('python3 não encontrado.');
  return r.status ?? 1;
}

function registrar({ project, files, outDir }) {
  const top = run('git', ['rev-parse', '--show-toplevel'], outDir);
  if (top.status !== 0) throw new Error(`--registrar: ${outDir} não está dentro de um repositório git.`);
  const add = run('git', ['add', '--', ...files], outDir);
  if (add.status !== 0) throw new Error(`git add falhou:\n${add.stderr}`);
  const msg = `Registro: ${project.meta.id} — ${project.meta.title}`;
  const commit = run('git', ['commit', '-m', msg, '--', ...files], outDir);
  if (commit.status !== 0) {
    if (/nothing to commit|nada a submeter/i.test(commit.stdout + commit.stderr)) {
      console.log('    (sem mudanças desde o último registro)');
      return;
    }
    throw new Error(`git commit falhou:\n${commit.stderr || commit.stdout}`);
  }
  const push = run('git', ['push'], outDir);
  if (push.status !== 0) {
    console.warn(`    registrado só neste computador (git push falhou):\n${push.stderr.trim()}`);
    return;
  }
  console.log(`    registrado e enviado ao GitHub: "${msg}"`);
}

/** Se a pasta de projetos é um clone git, busca as versões novas (iPhone → GitHub → aqui). */
function pullProjects(dir) {
  if (!existsSync(dir)) return;
  if (run('git', ['rev-parse', '--is-inside-work-tree'], dir).status !== 0) return;
  if (!run('git', ['remote'], dir).stdout.trim()) return;
  process.stdout.write('Buscando versões novas no GitHub… ');
  const r = run('git', ['pull', '--ff-only', '--quiet'], dir);
  console.log(r.status === 0 ? 'ok' : `não deu (${(r.stderr || '').trim().split('\n')[0]}) — seguindo com o que há aqui`);
}

const ROOT = dirname(fileURLToPath(import.meta.url));
const MIME = {
  '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8',
  '.json': 'application/json; charset=utf-8', '.svg': 'image/svg+xml', '.png': 'image/png',
  '.webmanifest': 'application/manifest+json', '.ico': 'image/x-icon', '.mid': 'audio/midi', '.pdf': 'application/pdf',
};

function serve(args) {
  const i = args.indexOf('--port');
  const port = i >= 0 ? Number(args[i + 1]) : 8080;
  const server = createServer((req, res) => {
    const url = decodeURIComponent(new URL(req.url, 'http://x').pathname);
    let file = resolve(ROOT, `.${url}`);
    if (file !== ROOT && !file.startsWith(ROOT + sep)) { res.writeHead(403).end(); return; }
    if (existsSync(file) && statSync(file).isDirectory()) file = join(file, 'index.html');
    if (!existsSync(file) || /(^|[/\\])\.(?!well-known)/.test(relative(ROOT, file))) { res.writeHead(404).end('404'); return; }
    res.writeHead(200, { 'Content-Type': MIME[extname(file)] || 'application/octet-stream', 'Cache-Control': 'no-cache' });
    res.end(readFileSync(file));
  });
  server.listen(port, '0.0.0.0', () => {
    console.log(`MZK Composer rodando:\n  neste computador:  http://localhost:${port}`);
    for (const list of Object.values(networkInterfaces())) {
      for (const a of list || []) {
        if (a.family === 'IPv4' && !a.internal) console.log(`  no iPhone (mesmo Wi-Fi): http://${a.address}:${port}`);
      }
    }
    console.log('Ctrl+C para parar.');
  });
  return new Promise(() => {});
}

function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') {
    console.log(HELP);
    return 0;
  }
  if (cmd === 'serve') return serve(rest);
  if (cmd === 'polir') return polir(rest);
  if (cmd !== 'build' && cmd !== 'render') {
    console.error(`Comando desconhecido: ${cmd}\n\n${HELP}`);
    return 2;
  }
  const opts = parseArgs(rest);
  const dir = projectsDir(opts);
  if (opts.pull) pullProjects(dir);
  let paths;
  if (opts.all) {
    if (!existsSync(dir)) throw new Error(`Diretório de projetos não existe: ${dir} (use --dir)`);
    paths = readdirSync(dir).filter((f) => f.endsWith('.json')).sort().map((f) => join(dir, f));
  } else {
    if (!opts.targets.length) throw new Error('Informe um ID (MZK-0042), um arquivo .json ou --all.');
    paths = opts.targets.map((t) => resolveTarget(t, dir));
  }

  const sc = cmd === 'render' ? scsynthCommand() : null;
  let failures = 0;
  for (const p of paths) {
    try {
      if (sc) {
        renderOne(p, opts, sc);
        continue;
      }
      const result = buildOne(p, opts);
      if (opts.registrar) registrar(result);
    } catch (e) {
      failures++;
      console.error(`✗ ${e.message}`);
    }
  }
  return failures ? 1 : 0;
}

try {
  const code = main();
  if (typeof code === 'number') process.exitCode = code;
} catch (e) {
  console.error(`✗ ${e.message}`);
  process.exitCode = 2;
}
